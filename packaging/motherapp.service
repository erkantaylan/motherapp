#@ Template, not a unit to copy: install.sh renders it into
#@ ~/.config/systemd/user/motherapp.service, replacing @NODE@ with the absolute path of a
#@ Node >= 24 binary and @REPO_DIR@ with the absolute path of the checkout. Lines starting
#@ with "#@" are dropped.
# systemd *user* unit for the motherapp core, generated by install.sh from
# packaging/motherapp.service. Don't edit it by hand: re-run ./install.sh after moving the
# checkout or changing Node.
# Runs in the login session so tools can reach PipeWire under $XDG_RUNTIME_DIR. No root.
[Unit]
Description=motherapp control panel (core manager)
After=pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire.service

[Service]
Type=simple
ExecStart="@NODE@" "@REPO_DIR@/core/src/main.ts"
WorkingDirectory=@REPO_DIR@
Restart=on-failure
RestartSec=2
# On stop, SIGTERM goes to the core only; it stops its tools one by one (SIGTERM, SIGKILL after
# 3 s) and exits once they have saved their state. With the default control-group mode every
# tool got a second SIGTERM from systemd and some died mid-save. Whatever is left when the core
# exits (or after TimeoutStopSec) gets SIGKILL.
KillMode=mixed
TimeoutStopSec=15
# The core prints one JSON line per log entry; journald keeps them.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=motherapp

[Install]
WantedBy=default.target
