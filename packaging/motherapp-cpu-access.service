#@ Template, not a unit to copy: install.sh renders it into
#@ /etc/systemd/system/motherapp-cpu-access.service (with sudo, after asking), replacing
#@ @GROUP@ with the user's primary group. Lines starting with "#@" are dropped.
# systemd *system* unit, generated by motherapp's install.sh from
# packaging/motherapp-cpu-access.service. Lets group @GROUP@ write the CPU clock caps,
# governor, EPP, turbo and power limit (PL1/PL2) files in /sys, for the motherapp CPU tool.
# Runs at boot and again after every resume. ./install.sh --uninstall removes it.
[Unit]
Description=motherapp: let group @GROUP@ set CPU clock caps, turbo, EPP and power limits
After=systemd-modules-load.service suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/motherapp/cpu-access @GROUP@

[Install]
WantedBy=multi-user.target suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
