#@ Template, not a rule to copy: install.sh renders it into
#@ /etc/udev/rules.d/70-motherapp-energy.rules (with sudo, after asking, on AMD only),
#@ replacing @GROUP@ with the user's primary group. Lines starting with "#@" are dropped.
# udev rule, generated by motherapp's install.sh from packaging/motherapp-energy.rules. Lets
# group @GROUP@ read the package RAPL energy counter (energy_uj), for the package power on the
# motherapp CPU page. Read only. The glob also matches subzones (intel-rapl:0:0); the helper
# refuses those. ./install.sh --uninstall removes it.
ACTION=="add", SUBSYSTEM=="powercap", KERNEL=="intel-rapl:[0-9]*|intel-rapl-mmio:[0-9]*", RUN+="/usr/local/lib/motherapp/energy-access @GROUP@ %k"
