{
  "id": "tmux",
  "title": "tmux",
  "icon": "🖥️",
  "serve": ["node", "tmuxctl.ts", "serve"],
  "page": "page.ts",
  "bin": { "tmuxctl": "tmuxctl.ts" },
  "commands": {
    "tmuxctl": [
      { "title": "Kill the tmux session 'scratch'", "args": ["kill", "scratch"] }
    ]
  },
  "defaultEnabled": true,
  "wide": true,
  "localActions": ["open", "view", "history", "send"],
  "notifications": [
    { "id": "finished", "label": "A session finished", "sound": "bell" },
    { "id": "waiting", "label": "A session is waiting on you", "sound": "window-attention" }
  ]
}
